// prisma/schema/base.prisma
// Configuración base: datasource, generator y enums compartidos
// Todos los archivos .prisma en prisma/schema/ se combinan (Prisma 6 multi-file)

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, citext, pgTrgm(map: "pg_trgm")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// === Enums globales ===

/// Roles predeterminados del sistema (RBAC) — se expande en Fase 1
enum SystemRole {
  ADMIN // Administrador — Acceso total
  MANAGER // Gerente — CRUD operativo
  ACCOUNTANT // Contador — Contabilidad y facturación
  SALESPERSON // Vendedor — Ventas y CRM
  AUDITOR // Auditor — Solo lectura + auditoría
}

/// Acciones de auditoría
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Estados genéricos de documentos
enum DocumentStatus {
  DRAFT // Borrador
  PUBLISHED // Publicado/Activo
  CANCELLED // Cancelado
}

/// Tipos de contacto
enum ContactType {
  NATURAL // Persona natural
  JURIDICAL // Persona jurídica
}

/// Tipos de dirección de contacto
enum AddressType {
  BILLING // Facturación
  SHIPPING // Envío
  FISCAL // Domicilio fiscal (SAR)
  OTHER // Otro
}

/// Naturaleza de cuenta contable (NIIF)
enum AccountNature {
  DEBIT // Deudora
  CREDIT // Acreedora
}

/// Tipos de cuenta contable (clasificación NIIF)
enum AccountType {
  ASSET // Activo
  LIABILITY // Pasivo
  EQUITY // Patrimonio/Capital
  INCOME // Ingreso
  COST // Costo
  EXPENSE // Gasto
  CONTRA // Cuenta de orden/contrarrestante (ej: depreciación acumulada)
}

/// Propósito del sistema para cuentas con rol especial (automatización de asientos)
/// Permite que publishInvoice encuentre las cuentas correctas sin depender de códigos fijos.
/// Cada empresa puede tener como máximo UNA cuenta activa por systemPurpose.
enum SystemAccountPurpose {
  ACCOUNTS_RECEIVABLE // Cuentas por Cobrar Clientes (ej: 1103)
  ISV_PAYABLE // ISV por Pagar (ej: 2102)
  SALES_REVENUE // Ingresos por Ventas (ej: 4101)
  ACCOUNTS_PAYABLE // Cuentas por Pagar Proveedores (ej: 2103) — Fase futura
  PURCHASE_EXPENSE // Gastos de Compra (ej: 5101) — Fase futura
}

/// Estados de período fiscal
enum FiscalPeriodStatus {
  OPEN // Abierto — permite asientos
  CLOSED // Cerrado — no permite asientos
  LOCKED // Bloqueado — cierre definitivo, solo lectura (auditoría)
}

/// Estados de factura fiscal
enum InvoiceStatus {
  DRAFT // Borrador
  PUBLISHED // Publicada con número SAR (facturas de venta)
  POSTED // Registrada contablemente (facturas de compra — sin número SAR)
  PAID // Pagada
  CANCELLED // Cancelada / Anulada
}
