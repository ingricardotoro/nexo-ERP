// prisma/schema/accounting.prisma
// Módulo Contabilidad NIIF (Fase 2 — F2-04):
// Currency, ExchangeRate, Account, FiscalYear, FiscalPeriod,
// Journal, JournalEntry, JournalEntryLine

// =============================================================================
// Enums de Contabilidad
// =============================================================================

/// Tipo de diario contable — define el propósito del libro de diario
enum JournalType {
  GENERAL // Diario General
  SALES // Diario de Ventas
  PURCHASES // Diario de Compras
  CASH // Diario de Caja
  BANK // Diario de Bancos
  PAYROLL // Diario de Nómina
  ADJUSTMENT // Diario de Ajustes
}

/// Estado del asiento contable
enum JournalEntryStatus {
  DRAFT // Borrador — editable, no afecta saldos
  POSTED // Publicado — contabilizado, afecta saldos
  CANCELLED // Anulado — sin efecto contable
}

// =============================================================================
// Currency — tabla de plataforma (sin companyId, sin RLS)
// =============================================================================

/// Moneda — catálogo global de plataforma.
/// No lleva company_id ni RLS: todas las empresas comparten el mismo catálogo.
/// La moneda base del tenant se configura en Company.baseCurrency.
model Currency {
  /// Código ISO 4217 (ej: "HNL", "USD", "EUR")
  code     String  @id
  name     String // "Lempira hondureño", "Dólar estadounidense"
  symbol   String // "L", "$", "€"
  isActive Boolean @default(true) @map("is_active")
  /// true solo para la moneda base del sistema (HNL por defecto en Honduras)
  isBase   Boolean @default(false) @map("is_base")

  // Relaciones
  exchangeRates    ExchangeRate[]
  journalEntries   JournalEntry[]
  invoices         Invoice[] // facturas en esta moneda (Fase 3)
  supplierInvoices SupplierInvoice[] // facturas de compra en esta moneda (F3-07)
  bankAccounts     BankAccount[] // cuentas bancarias en esta moneda (F2-13)
  purchaseOrders   PurchaseOrder[] // órdenes de compra en esta moneda (Fase 4 S2)
  salesOrders      SalesOrder[] // pedidos de venta en esta moneda (Fase 4 S3)

  @@map("currencies")
}

// =============================================================================
// ExchangeRate — tipo de cambio (global o por empresa)
// =============================================================================

/// Tipo de cambio — puede ser global (companyId = null) o específico de empresa.
/// Un índice parcial garantiza unicidad global: solo una tasa global por moneda/fecha
/// cuando company_id IS NULL (se crea manualmente en la migración SQL, ver F2-04).
model ExchangeRate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  currencyCode String   @map("currency_code")
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  date DateTime @db.Date
  rate Decimal  @db.Decimal(12, 6)

  /// Fuente del tipo de cambio (ej: "BCH", "manual", "API")
  source String?

  /// Nullable: null = tasa global de plataforma; UUID = tasa específica de empresa
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // UNIQUE por (moneda, fecha, empresa) — permite una tasa global y una por empresa
  @@unique([currencyCode, date, companyId])
  // Índices — company_id siempre presente cuando no es null (DAR-005)
  @@index([currencyCode, date])
  @@index([companyId, currencyCode, date])
  @@map("exchange_rates")
}

// =============================================================================
// Account — catálogo de cuentas contables por empresa (Plan de Cuentas)
// =============================================================================

/// Cuenta contable — nodo del Plan de Cuentas NIIF por empresa.
/// Soporta jerarquía recursiva: una cuenta padre puede contener N cuentas hijas.
/// Solo las cuentas hoja (isParent = false, allowDirectEntry = true) admiten asientos.
model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Multi-tenant — siempre presente (DAR-005)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Cuenta padre (nullable — null indica cuenta raíz de nivel 1)
  parentId String?   @map("parent_id") @db.Uuid
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountHierarchy")

  /// Código de cuenta (ej: "1101", "1101-01")
  code String
  name String

  accountType   AccountType   @map("account_type")
  accountNature AccountNature @map("account_nature")

  /// Propósito del sistema — solo para cuentas con rol especial en automatización
  /// de asientos (ej: ACCOUNTS_RECEIVABLE para publishInvoice).
  /// Nullable — la mayoría de cuentas no tienen propósito especial.
  /// Máximo UNA cuenta activa por (companyId, systemPurpose).
  systemPurpose SystemAccountPurpose? @map("system_purpose")

  /// true = cuenta de agrupación; false = cuenta hoja que admite asientos
  isParent         Boolean @default(false) @map("is_parent")
  /// false en cuentas padre — evita asientos directos en cuentas de agrupación
  allowDirectEntry Boolean @default(true) @map("allow_direct_entry")
  isActive         Boolean @default(true) @map("is_active")
  description      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones hijas
  journalEntryLines    JournalEntryLine[]
  invoiceLines         InvoiceLine[] // líneas de factura que usan esta cuenta (Fase 3)
  supplierInvoiceLines SupplierInvoiceLine[] // líneas de factura de compra (F3-07)
  purchaseOrderLines   PurchaseOrderLine[] // líneas de OC (Fase 4 S2)
  salesOrderLines      SalesOrderLine[] // líneas de pedido de venta (Fase 4 S3)
  bankAccounts         BankAccount[] // cuentas bancarias vinculadas (F2-13)

  // Índices — company_id siempre primero (DAR-005)
  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, accountType])
  @@index([companyId, isActive])
  @@index([companyId, allowDirectEntry])
  @@index([companyId, systemPurpose])
  @@map("accounts")
}

// =============================================================================
// FiscalYear — año fiscal por empresa
// =============================================================================

/// Año fiscal — período anual de contabilidad por empresa.
/// Contiene N períodos fiscales mensuales (FiscalPeriod).
model FiscalYear {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Multi-tenant — siempre presente (DAR-005)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Año calendario (ej: 2026)
  year      Int
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    FiscalPeriodStatus @default(OPEN)
  isActive  Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones hijas
  fiscalPeriods FiscalPeriod[]

  // Índices — company_id siempre primero (DAR-005)
  @@unique([companyId, year])
  @@index([companyId, status])
  @@index([companyId, isActive])
  @@map("fiscal_years")
}

// =============================================================================
// FiscalPeriod — período fiscal mensual (companyId desnormalizado para RLS)
// =============================================================================

/// Período fiscal — mes contable dentro de un año fiscal.
/// company_id desnormalizado para que RLS opere sobre la fila directamente
/// sin JOIN al padre (mismo patrón que ContactAddress/ContactPerson).
model FiscalPeriod {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// company_id desnormalizado: RLS opera sobre la fila directamente sin JOIN al padre
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  fiscalYearId String     @map("fiscal_year_id") @db.Uuid
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  /// Número de período dentro del año (1 = enero … 12 = diciembre)
  periodNumber Int                @map("period_number")
  /// Nombre descriptivo (ej: "Enero 2026")
  name         String
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  status       FiscalPeriodStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones hijas
  journalEntries JournalEntry[]

  // Índices — company_id siempre primero (DAR-005)
  @@unique([fiscalYearId, periodNumber])
  @@index([companyId, fiscalYearId])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_periods")
}

// =============================================================================
// Journal — libro de diario por empresa
// =============================================================================

/// Diario contable — agrupa asientos de un mismo tipo (ventas, compras, caja…).
/// Cada empresa configura sus propios diarios (ej: "DJ", "LV", "LC").
model Journal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Multi-tenant — siempre presente (DAR-005)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name        String
  /// Código corto identificador del diario (ej: "DJ", "LV", "LC")
  code        String
  journalType JournalType @map("journal_type")
  isActive    Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones hijas
  journalEntries   JournalEntry[]
  journalSequences JournalSequence[]

  // Índices — company_id siempre primero (DAR-005)
  @@unique([companyId, code])
  @@index([companyId, journalType])
  @@index([companyId, isActive])
  @@map("journals")
}

// =============================================================================
// JournalEntry — asiento contable (cabecera)
// =============================================================================

/// Asiento contable (cabecera) — agrupa las líneas de débito/crédito.
/// Un asiento debe cumplir la ecuación: totalDebit = totalCredit (balance NIIF).
/// entryNumber es secuencial por (companyId, journalId).
model JournalEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Multi-tenant — siempre presente (DAR-005)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  journalId String  @map("journal_id") @db.Uuid
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  fiscalPeriodId String       @map("fiscal_period_id") @db.Uuid
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)

  /// Número secuencial del asiento dentro del diario por empresa
  entryNumber Int     @map("entry_number")
  reference   String?
  description String

  entryDate DateTime           @map("entry_date") @db.Date
  status    JournalEntryStatus @default(DRAFT)

  currencyCode String   @map("currency_code")
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  /// Tipo de cambio a la moneda base (1.0 si la moneda ya es la base)
  exchangeRate Decimal @default(1) @map("exchange_rate") @db.Decimal(12, 6)

  /// Totales en moneda base — mantenidos por triggers o lógica de aplicación
  totalDebit  Decimal @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit Decimal @default(0) @map("total_credit") @db.Decimal(18, 2)

  /// ID del usuario (Cognito sub) que creó el asiento
  createdBy String    @map("created_by")
  /// ID del usuario que publicó/contabilizó el asiento (null si aún es DRAFT)
  postedBy  String?   @map("posted_by")
  postedAt  DateTime? @map("posted_at")

  /// Enlace al asiento que anuló este (solo presente en asientos CANCELLED)
  cancelledById String?        @map("cancelled_by_id") @db.Uuid
  cancelledBy   JournalEntry?  @relation("EntryCancellation", fields: [cancelledById], references: [id])
  /// Asientos de anulación generados a partir de este
  cancellations JournalEntry[] @relation("EntryCancellation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones hijas
  lines           JournalEntryLine[]
  invoice         Invoice? // relación inversa desde Facturación (Fase 3)
  supplierInvoice SupplierInvoice? // relación inversa desde Facturas de Compra (F3-07)

  // Índices — company_id siempre primero (DAR-005)
  @@unique([companyId, journalId, entryNumber])
  @@index([companyId, journalId, entryDate])
  @@index([companyId, fiscalPeriodId, status])
  @@index([companyId, status])
  @@index([companyId, entryDate])
  @@index([companyId, createdBy])
  @@map("journal_entries")
}

// =============================================================================
// JournalEntryLine — línea de asiento contable (companyId desnormalizado para RLS)
// =============================================================================

/// Línea de asiento contable — representa un movimiento débito o crédito en una cuenta.
/// company_id desnormalizado para que RLS opere sobre la fila directamente
/// sin JOIN al padre (mismo patrón que FiscalPeriod/ContactAddress).
/// Los importes en moneda extranjera se guardan en currencyDebit/currencyCredit;
/// los importes en moneda base en debit/credit.
model JournalEntryLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// company_id desnormalizado: RLS opera sobre la fila directamente sin JOIN al padre
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// Número de línea dentro del asiento (1-based)
  lineNumber  Int     @map("line_number")
  description String?

  /// Importes en moneda base
  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  /// Importes en moneda original del asiento (moneda extranjera)
  currencyDebit  Decimal @default(0) @map("currency_debit") @db.Decimal(18, 2)
  currencyCredit Decimal @default(0) @map("currency_credit") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones inversas
  bankTransactions BankTransaction[] // transacciones bancarias conciliadas contra esta línea (F2-13)

  // Índices — company_id siempre primero (DAR-005)
  @@unique([journalEntryId, lineNumber])
  @@index([companyId, journalEntryId])
  @@index([companyId, accountId])
  @@index([companyId, accountId, createdAt])
  @@map("journal_entry_lines")
}

// =============================================================================
// JournalSequence — numeración secuencial atómica por diario (F2-09)
// =============================================================================

/// Contador de secuencia por (companyId, journalId).
/// El servicio usa INSERT ... ON CONFLICT DO UPDATE ... RETURNING para garantizar
/// atomicidad sin race conditions bajo concurrencia serverless.
model JournalSequence {
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  journalId String  @map("journal_id") @db.Uuid
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  lastNumber Int @default(0) @map("last_number")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([companyId, journalId])
  @@map("journal_sequences")
}

// =============================================================================
// Conciliación Bancaria — F2-13
// =============================================================================

/// Tipo de cuenta bancaria
enum BankAccountType {
  CHECKING // Cuenta corriente
  SAVINGS // Cuenta de ahorros
  CREDIT // Tarjeta de crédito
}

/// Estado de la conciliación bancaria
enum BankReconciliationStatus {
  DRAFT // En proceso de conciliación
  RECONCILED // Conciliada y cerrada
}

/// Estado de una transacción bancaria
enum BankTransactionStatus {
  PENDING // Sin conciliar
  MATCHED // Asociada a un asiento contable
  RECONCILED // Conciliada y cerrada (parte de una BankReconciliation finalizada)
  IGNORED // Marcada como ignorada (ej: comisión sin asiento)
}

/// Cuenta bancaria — vincula el estado de cuenta físico con la cuenta contable.
/// Un BankAccount corresponde a una cuenta contable de tipo ASSET que representa
/// el saldo del banco en el libro mayor.
model BankAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Nombre descriptivo del banco (ej: "Banco Atlántida — CTA CTE 001-12345")
  name String

  /// Nombre de la institución bancaria
  bankName String @map("bank_name")

  /// Número de cuenta bancaria (puede ser parcialmente enmascarado)
  accountNumber String @map("account_number")

  /// Tipo de cuenta
  accountType BankAccountType @default(CHECKING) @map("account_type")

  /// Cuenta contable en el plan de cuentas que representa este banco (tipo ASSET)
  ledgerAccountId String  @map("ledger_account_id") @db.Uuid
  ledgerAccount   Account @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  /// Moneda de la cuenta
  currencyCode String   @default("HNL") @map("currency_code")
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  /// Saldo actual según los libros (actualizado al conciliar)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(18, 2)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  statements      BankStatement[]
  reconciliations BankReconciliation[]

  @@unique([companyId, accountNumber])
  @@index([companyId, isActive])
  @@map("bank_accounts")
}

/// Estado de cuenta bancario importado (mensual o por rango de fechas).
/// Contiene las transacciones del banco para un período.
model BankStatement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bankAccountId String      @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  /// Período que cubre este estado de cuenta
  statementDate DateTime @map("statement_date") @db.Date
  periodFrom    DateTime @map("period_from") @db.Date
  periodTo      DateTime @map("period_to") @db.Date

  /// Saldo inicial y final del estado de cuenta
  beginningBalance Decimal @map("beginning_balance") @db.Decimal(18, 2)
  endingBalance    Decimal @map("ending_balance") @db.Decimal(18, 2)

  /// Referencia del archivo importado
  importedFileName String?  @map("imported_file_name")
  importedAt       DateTime @default(now()) @map("imported_at")
  importedBy       String   @map("imported_by")

  createdAt DateTime @default(now()) @map("created_at")

  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  @@index([companyId, bankAccountId])
  @@index([companyId, periodFrom, periodTo])
  @@map("bank_statements")
}

/// Transacción individual del estado de cuenta bancario.
model BankTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bankStatementId String        @map("bank_statement_id") @db.Uuid
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  /// Fecha de la transacción según el banco
  transactionDate DateTime @map("transaction_date") @db.Date

  /// Descripción o referencia tal como aparece en el estado de cuenta
  description String

  /// Referencia adicional (número de cheque, número de transacción, etc.)
  reference String?

  /// Monto: positivo = crédito (depósito), negativo = débito (retiro/pago)
  /// Usamos un solo campo con signo para simplificar
  amount Decimal @db.Decimal(18, 2)

  status BankTransactionStatus @default(PENDING)

  /// Línea de asiento contable asociada (cuando status=MATCHED o RECONCILED)
  journalEntryLineId String?           @map("journal_entry_line_id") @db.Uuid
  journalEntryLine   JournalEntryLine? @relation(fields: [journalEntryLineId], references: [id])

  /// Notas de la conciliación
  matchNotes String? @map("match_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId, bankStatementId])
  @@index([companyId, status])
  @@index([companyId, transactionDate])
  @@map("bank_transactions")
}

/// Conciliación bancaria — registro del proceso de conciliación para un período.
model BankReconciliation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  bankAccountId String      @map("bank_account_id") @db.Uuid
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  bankStatementId String        @map("bank_statement_id") @db.Uuid
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Restrict)

  status BankReconciliationStatus @default(DRAFT)

  /// Saldo según el estado de cuenta (banco)
  statementEndingBalance Decimal @map("statement_ending_balance") @db.Decimal(18, 2)

  /// Saldo según los libros contables (libro mayor de la cuenta bancaria)
  ledgerBalance Decimal @map("ledger_balance") @db.Decimal(18, 2)

  /// Diferencia no conciliada = statementEndingBalance - ledgerBalance
  difference Decimal @default(0) @db.Decimal(18, 2)

  /// Total de transacciones del banco conciliadas
  reconciledAmount Decimal @default(0) @map("reconciled_amount") @db.Decimal(18, 2)

  /// Total de transacciones pendientes (del banco sin contabilizar)
  unreconciledStatementAmount Decimal @default(0) @map("unreconciled_statement_amount") @db.Decimal(18, 2)

  /// Total de asientos contables sin transacción bancaria
  unreconciledLedgerAmount Decimal @default(0) @map("unreconciled_ledger_amount") @db.Decimal(18, 2)

  reconciledBy String?   @map("reconciled_by")
  reconciledAt DateTime? @map("reconciled_at")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, bankAccountId, bankStatementId])
  @@index([companyId, bankAccountId])
  @@index([companyId, status])
  @@map("bank_reconciliations")
}
